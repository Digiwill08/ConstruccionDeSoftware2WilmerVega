{
  "info": {
    "_postman_id": "company-loan-flow-001",
    "name": "Company Loan Flow - Local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Flujo: login -> crear company client -> crear cuenta -> solicitar préstamo -> aprobar préstamo (local)"
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"analista\",\n  \"password\": \"pass123\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.environment.set('token', json.token);",
              "pm.environment.set('tokenType', json.tokenType);",
              "console.log('Saved token');"
            ]
          }
        }
      ]
    },
    {
      "name": "Employee - Create Company Client",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"businessName\": \"Empresa Demo S.A.S.\",\n  \"documentNumber\": \"900123456\",\n  \"email\": \"contabilidad@empresa-demo.com\",\n  \"phone\": \"3001234567\",\n  \"address\": \"Calle 123 #45-67\",\n  \"legalRepresentativeId\": 1\n}"
        },
        "url": "{{baseUrl}}/api/customers/company"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const j = pm.response.json();",
              "if (j && j.id) { pm.environment.set('companyClientId', j.id); }",
              "console.log('companyClientId =', pm.environment.get('companyClientId'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Employee - Create Account",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountNumber\": \"ACCEMP001\",\n  \"accountType\": \"BUSINESS\",\n  \"currency\": \"USD\",\n  \"holderId\": {{companyClientId}},\n  \"initialBalance\": 25000000\n}"
        },
        "url": "{{baseUrl}}/api/accounts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const j = pm.response.json();",
              "if (j && j.id) pm.environment.set('accountId', j.id);",
              "if (j && j.accountNumber) pm.environment.set('accountNumber', j.accountNumber);",
              "console.log('accountId =', pm.environment.get('accountId'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Employee - Create Loan",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"loanType\": \"BUSINESS\",\n  \"clientApplicant\": { \"id\": {{companyClientId}} },\n  \"requestedAmount\": 50000000,\n  \"approvedAmount\": 45000000,\n  \"interestRate\": 1.8,\n  \"termInMonths\": 36,\n  \"loanStatus\": \"UNDER_REVIEW\"\n}"
        },
        "url": "{{baseUrl}}/api/employee/loans"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const j = pm.response.json();",
              "if (j && j.id) pm.environment.set('loanId', j.id);",
              "console.log('loanId =', pm.environment.get('loanId'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Analyst - Approve Loan",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/analyst/loans/{{loanId}}/approve?analystUserId=1&role=INTERNAL_ANALYST"
      }
    }
  ]
}
