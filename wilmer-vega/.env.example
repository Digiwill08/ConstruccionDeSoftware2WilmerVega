# ======================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env (local development only)
# For production, set these as environment variables
# ======================================================

# -------------------------------------------------------
# MySQL Database (transaccional)
# -------------------------------------------------------
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/bank_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=root
MYSQL_PASSWORD=

# -------------------------------------------------------
# MongoDB (audit logs)
# -------------------------------------------------------
# Local development (default)
MONGODB_URI=mongodb://127.0.0.1:27017/bank_audit_db?connectTimeoutMS=5000&socketTimeoutMS=5000&serverSelectionTimeoutMS=5000
MONGODB_DATABASE=bank_audit_db
MONGODB_REQUIRED=true

# -------------------------------------------------------
# JWT Security (CRITICAL - CHANGE IN PRODUCTION)
# -------------------------------------------------------
# Generate a strong secret key in production:
#   openssl rand -base64 32
# NEVER commit real secrets to repository
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_STRONG_KEY_MIN_32_CHARS

# -------------------------------------------------------
# Server
# -------------------------------------------------------
SERVER_PORT=8083
